\newcommand{\edu}[4]{
\noindent
  \begin{tabular}[t]{p{\textwidth}}
    \textbf{#1} \hfill #2 \\        % bold title
    \hspace{1em}- #3\\             % indented with hyphen
    \hspace{1em}- #4               % indented with hyphen
  \end{tabular}
}

\newcommand{\researchInterest}[1]{
        \begin{tabular}[t]{p{\textwidth}}
